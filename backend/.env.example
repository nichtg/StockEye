# Copy to .env and adjust. Every setting is read from STOCKEYE_* environment variables.

# dev | test | prod  (prod refuses to start with the default JWT secret)
STOCKEYE_ENVIRONMENT=dev
STOCKEYE_LOG_LEVEL=INFO

# Local MongoDB, or an Atlas SRV string such as mongodb+srv://user:pass@cluster.mongodb.net
STOCKEYE_MONGODB_URI=mongodb://127.0.0.1:27017
STOCKEYE_MONGODB_DB=stockeye

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
STOCKEYE_JWT_SECRET=replace-me-with-a-long-random-string
STOCKEYE_ACCESS_TOKEN_TTL_MINUTES=15
STOCKEYE_REFRESH_TOKEN_TTL_DAYS=14
# Set to false only for plain-http local development
STOCKEYE_COOKIE_SECURE=false
# JSON list of allowed browser origins
STOCKEYE_CORS_ORIGINS=["http://localhost:5173"]
STOCKEYE_LOGIN_MAX_FAILURES=5
STOCKEYE_LOGIN_LOCKOUT_MINUTES=15

# Optional provider keys (providers without a key are skipped)
# STOCKEYE_FINNHUB_API_KEY=
# STOCKEYE_ALPHAVANTAGE_API_KEY=
# STOCKEYE_MARKETAUX_API_KEY=

# Self-imposed provider call budgets: STOCKEYE_PROVIDER_LIMITS__<provider>__<per_minute|per_day>.
# Providers: yahoo, google_news, finnhub, alphavantage, marketaux
STOCKEYE_PROVIDER_LIMITS__yahoo__per_minute=60
STOCKEYE_PROVIDER_LIMITS__yahoo__per_day=4000
STOCKEYE_PROVIDER_LIMITS__google_news__per_minute=20
STOCKEYE_PROVIDER_LIMITS__google_news__per_day=1500
STOCKEYE_PROVIDER_LIMITS__finnhub__per_minute=50
STOCKEYE_PROVIDER_LIMITS__finnhub__per_day=40000
STOCKEYE_PROVIDER_LIMITS__alphavantage__per_minute=5
STOCKEYE_PROVIDER_LIMITS__alphavantage__per_day=25
STOCKEYE_PROVIDER_LIMITS__marketaux__per_minute=10
STOCKEYE_PROVIDER_LIMITS__marketaux__per_day=100
# Fraction of a budget at which a quota warning is raised
STOCKEYE_QUOTA_WARNING_RATIO=0.8

# FinBERT ONNX model location (fetched by scripts/download_finbert.py)
STOCKEYE_FINBERT_MODEL_DIR=models/finbert
STOCKEYE_SCHEDULER_ENABLED=true

# Used only by `python -m app.cli create-admin` (otherwise you are prompted)
# STOCKEYE_ADMIN_PASSWORD=
